<%= link_to "← Back to month calendar", calendar_path(month: @date.strftime("%Y-%m"), anchor: "month-calendar"), class: "back-link" %><section class="page-intro"><div><div class="eyebrow">YOUR DAILY JOURNAL</div><h1><%= @date.strftime('%A, %B %-d, %Y') %></h1></div><div class="day-navigation"><%= link_to "← Previous", journal_path(@date - 1), class: "button secondary" %><input type="date" aria-label="Choose journal date" value="<%= @date %>" data-controller="day-picker" data-action="change->day-picker#go"><%= link_to "Next →", journal_path(@date + 1), class: "button secondary" %></div></section>
<div class="journal-grid"><section class="card form-card"><h2>How was your day?</h2><%= errors_for(@note) %>
<%= render "form", return_to: nil %>
<% if @note.persisted? %><%= button_to "Delete this day’s notes & metrics", journal_path(@date), method: :delete, class: "danger-link", data: { turbo_confirm: "Delete this day’s journal? Weight and injection logs are kept." } %><% end %></section>
<section class="card day-entries"><div class="eyebrow">THE DAY’S CHECK-INS</div><h2>Weight &amp; injections</h2>
<% @weights.each do |w| %><article class="day-event"><span class="type-pill weight">Weight</span><h3><%= weight_label(w) %></h3><p class="muted small"><%= local_time_label(w.recorded_at) %></p><%= link_to "Edit weigh-in →", edit_entry_path(w, kind: "weight") %></article><% end %>
<% @injections.each do |i| %><article class="day-event"><span class="type-pill injection">Zepbound</span><h3><%= dose_dot(i.dose) %><%= i.dose.to_s('F') %> mg</h3><p class="muted small"><%= local_time_label(i.recorded_at) %><br><%= [i.site, i.side].compact_blank.join(' · ') %></p><p class="pre-wrap"><%= i.notes %></p><%= link_to "Edit injection →", edit_entry_path(i, kind: "injection") %></article><% end %>
<% if @weights.empty? && @injections.empty? %><p class="muted">No weigh-ins or injections on this day.</p><% end %></section></div>
