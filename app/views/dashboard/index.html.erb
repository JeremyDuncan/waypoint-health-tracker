<div data-controller="modal chart-preferences" data-modal-open-value="<%= @filter_error || params[:edit_filters] == '1' %>" data-chart-preferences-state-value="<%= @chart_preferences.to_json %>" data-chart-preferences-url-value="<%= chart_preferences_path(page: 'overview') %>" data-action="timeline:preferences->chart-preferences#save modal:closed->chart-preferences#restoreFilters">
<section class="page-intro">
  <div><div class="eyebrow"><%= Time.zone.today.strftime("%A, %B %-d").upcase %></div><h1>Your health, over time.</h1></div>
  <div class="quick-actions"><%= link_to "＋ Log weight", new_entry_path(kind: "weight"), class: "button primary" %><%= link_to "＋ Log injection", new_entry_path(kind: "injection"), class: "button secondary" %></div>
</section>
<section class="summary-grid" aria-label="Your latest progress">
  <article class="summary card"><div class="eyebrow">LATEST WEIGHT</div><div class="stat"><%= @latest ? number_with_precision(@latest.in_unit(current_user.preferred_unit), precision: 1) : "—" %><span><%= current_user.preferred_unit %></span></div><div class="small muted"><%= @latest ? local_time_label(@latest.recorded_at) : "No weigh-ins yet" %></div></article>
  <article class="summary card" aria-label="Weight change in selected range">
    <div class="eyebrow">CHANGE IN SELECTED RANGE</div>
    <div class="summary-value-row"><div class="stat"><%= @range_change.nil? ? "—" : number_with_precision(@range_change, precision: 1, delimiter: ",") %><span><%= current_user.preferred_unit %></span></div><% unless @range_change_percent.nil? %><span class="range-percent"><%= percent_loss_label(@range_change_percent) %></span><% end %></div>
    <div class="small muted"><% if !@range_change.nil? %>From <%= @range_first.recorded_at.in_time_zone.strftime('%b %-d, %Y') %> · <%= number_with_precision(@range_first.in_unit(current_user.preferred_unit), precision: 1) %> <%= current_user.preferred_unit %><br>Through <%= @range_last.recorded_at.in_time_zone.strftime('%b %-d, %Y') %><% elsif @range_first %>Log another weigh-in in this range to see the change<% else %>No weigh-ins in this range<% end %></div>
  </article>
  <article class="summary card injection-summary"><div class="eyebrow">LAST LOGGED INJECTION</div><div class="stat"><%= dose_dot(@last_injection.dose) if @last_injection %><%= @last_injection ? @last_injection.dose.to_s("F") : "—" %><span>mg</span></div><div class="small muted"><%= @last_injection ? "Zepbound · #{local_time_label(@last_injection.recorded_at)}" : "No injections logged" %></div></article>
</section>
<% if current_user.reminder_at %><aside class="reminder"><span>◷ Planned reminder · <strong><%= local_time_label(current_user.reminder_at) %></strong></span></aside><% end %>
<section class="card timeline-card" data-controller="timeline" data-timeline-payload-value="<%= @range.chart.to_json %>">
  <div class="section-heading"><div><h2>Weight &amp; injections</h2></div><span class="small muted"><%= @range.from.strftime('%b %-d, %Y') %> – <%= @range.to.strftime('%b %-d, %Y') %></span></div>
  <div class="chart-toolbar">
    <button type="button" class="button secondary chart-filter-button" data-action="modal#open" aria-label="Filter overview chart"><%= render 'shared/filter_icon' %><span>Filters · <%= chart_range_label(@range.range) %></span></button>
    <label class="select-inline"><span class="select-inline-label">View</span> <%= select_tag :overview_view, options_for_select([['Every weigh-in','raw'],['Weekly averages','weekly'],['Monthly averages','monthly']], @chart_preferences['mode']), disabled: true, data: { timeline_target: 'mode', action: 'timeline#change' } %></label>
  </div>
  <div class="chart-preference-status"><span role="status" data-chart-preferences-target="status"></span><button type="button" class="text-button" data-chart-preferences-target="retry" data-action="chart-preferences#retry" hidden>Retry saving</button></div>
  <div class="chart-legend"><label><input type="checkbox" <%= 'checked' if @chart_preferences['trend'] %> data-timeline-target="trendToggle" data-action="timeline#change"><span class="trend-key"></span> 7-day trend</label><label><input type="checkbox" <%= 'checked' if @chart_preferences['weight'] %> data-timeline-target="weightToggle" data-action="timeline#change"><span class="dot green"></span> Weight</label><label><input type="checkbox" <%= 'checked' if @chart_preferences['injections'] %> data-timeline-target="injectionToggle" data-action="timeline#change"><span class="dot orange"></span> Injections</label><label><input type="checkbox" <%= 'checked' if @chart_preferences['notes'] %> data-timeline-target="noteToggle" data-action="timeline#change"><span class="dot gray"></span> Day notes</label></div>
  <div class="chart-scroll" data-timeline-target="scroll"><div class="chart-content" data-timeline-target="content"><div class="canvas-wrap"><canvas data-timeline-target="canvas" role="img" aria-label="Weight over time with actual injection date guides and dose labels in the same plot. Use the accessible table for exact readings and events."></canvas><div class="injection-overlay" data-timeline-target="injectionRow" aria-label="Actual injections on the weight timeline"></div></div><div class="event-track notes-track"><span class="track-title">JOURNAL</span><div class="event-lanes" data-timeline-target="noteRow" aria-label="Day notes"></div></div></div></div>
  <noscript><p>The interactive chart needs JavaScript. All entries are available in the table below.</p></noscript>
  <% if @range.events.empty? %><div class="empty-chart"><strong>No entries in this range.</strong></div><% end %>
  <div class="chart-foot"><p class="small muted" data-timeline-target="explanation"></p><span class="small muted">Tap a point or marker to open its day.</span></div>
  <%= render 'shared/dose_key', doses: @range.injections.map(&:dose) %>
</section>
<section class="below-chart"><div class="below-chart-actions"><%= link_to "Open monthly calendar →", calendar_path, class: "button secondary" %><%= link_to "Open today’s journal →", journal_path(Time.zone.today), class: "button secondary" %></div></section>
<details class="card range-table"><summary>History table <span class="muted">· <%= @range.events.size %> entries in selected range</span></summary><div class="table-scroll"><table><caption class="sr-only">Entries from <%= @range.from %> through <%= @range.to %> in <%= current_user.time_zone %></caption><thead><tr><th scope="col">Date &amp; time</th><th scope="col">Type</th><th scope="col">Entry</th><th scope="col">Details</th></tr></thead><tbody><% @range.events.each do |event| %><tr><td><%= event.is_a?(DayNote) ? event.local_date.strftime('%b %-d, %Y') : local_time_label(event.recorded_at) %></td><td><span class="type-pill <%= event.class.name.downcase %>"><%= event.is_a?(DayNote) ? "Journal" : event.class.name %></span></td><td><% if event.is_a?(Weight) %><%= weight_label(event) %><% elsif event.is_a?(Injection) %><%= dose_dot(event.dose) %><%= event.dose.to_s('F') %> mg · <%= [event.site, event.side].compact_blank.join(' · ').presence || 'Site not recorded' %><% else %><%= truncate(event.notes.presence || "Metrics recorded", length: 90) %><% end %></td><td><%= link_to "Open day →", journal_path(event.is_a?(DayNote) ? event.local_date : event.local_day) %></td></tr><% end %><% if @range.events.empty? %><tr><td colspan="4" class="muted">No entries in this range.</td></tr><% end %></tbody></table></div></details>

<%= render 'shared/chart_filter_dialog', page: 'overview' %>
</div>
