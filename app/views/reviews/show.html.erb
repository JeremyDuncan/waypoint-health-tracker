<section class="page-intro"><div><div class="eyebrow">A MOMENT TO LOOK BACK</div><h1>Your weekly review.</h1><p class="muted"><%= @review.from.strftime('%b %-d') %> – <%= @review.to.strftime('%b %-d, %Y') %><%= ' · Week in progress' if @review.partial? %></p></div><%= link_to 'Appointment report →', report_path(range: 'custom', from: @review.from, to: @review.through), class: 'button secondary' %></section>
<div class="feature-toolbar"><%= link_to '← Previous week', review_path(week: @review.from - 7), class: 'button secondary' %><%= link_to 'This week', review_path, class: 'button secondary' %><% if @review.from < Time.zone.today.beginning_of_week %><%= link_to 'Next week →', review_path(week: @review.from + 7), class: 'button secondary' %><% end %><%= form_with url: review_path, method: :get, class: 'week-picker' do |f| %><%= f.label :week, 'Week containing' %><%= f.date_field :week, value: @review.from, max: Time.zone.today, required: true %><%= f.submit 'View week', class: 'button secondary' %><% end %></div>
<section class="injection-summary-grid weekly-summary-grid" aria-label="Weekly summary">
  <article class="card insight-stat"><div class="eyebrow">AVERAGE WEIGHT</div><div class="stat"><%= metric_number(@review.average) %></div><p class="small muted"><%= pluralize(@review.current.weights.size, 'reading') %> across <%= pluralize(@review.weighed_days, 'day') %></p></article>
  <article class="card insight-stat" aria-label="Weight lost this week"><div class="eyebrow">THIS WEEK’S WEIGHT CHANGE</div><div class="stat weekly-percent"><%= percent_loss_label(@review.within_week_percent) %></div><p class="small muted"><% if @review.within_week_percent %>First to last actual reading · <%= metric_number(@review.current.weights.first.in_unit(@review.unit)) %> → <%= metric_number(@review.current.weights.last.in_unit(@review.unit)) %><% else %>Two weigh-ins in this week are needed<% end %></p></article>
  <article class="card insight-stat" aria-label="Weekly average percent weight change"><div class="eyebrow">WEEKLY AVERAGE % CHANGE</div><div class="stat weekly-percent"><%= percent_loss_label(@review.average_change_percent) %></div><p class="small muted">Compared with the previous week’s average<% if @review.previous_average %> · <%= metric_number(@review.previous_average) %><% end %></p></article>
  <article class="card insight-stat"><div class="eyebrow">VS PREVIOUS WEEK’S AVERAGE</div><div class="stat"><%= metric_number(@review.change) %></div><p class="small muted">Previous: <%= metric_number(@review.previous_average) %> · <%= pluralize(@review.previous.weights.size, 'reading') %></p></article>
  <article class="card insight-stat"><div class="eyebrow">ACTUAL SHOTS</div><div class="stat"><%= @review.current.injections.size %></div><p class="small muted">Only explicitly logged injections</p></article>
  <article class="card insight-stat"><div class="eyebrow">JOURNAL CHECK-INS</div><div class="stat"><%= @review.journal_days %></div><p class="small muted">Through <%= @review.through.strftime('%b %-d') %> · <%= link_to 'Goals & milestones →', goal_path %></p></article>
</section>
<p class="small muted">This week’s percentage compares its first and last actual readings. Weekly average percentage compares this week’s mean with the previous calendar week’s mean. Missing pairs or weeks stay unmeasured; loss and gain are labeled separately.</p>
<section class="card feature-card"><h2>This week’s picture</h2><%= render 'shared/weight_plot', plot: @review.plot, range: @review.current, shot_labels: true %><p class="small muted">Weeks run Monday–Sunday in <%= current_user.time_zone %>. Averages use all individual readings, not daily means. <%= @review.partial? ? 'This week is partial; the previous week is complete, so coverage differs.' : 'Weeks can have different numbers and timing of readings.' %></p></section>
<%= render 'days' %>
<div class="feature-columns">
  <section class="card feature-card"><h2>Journal metrics</h2><% if @review.metric_summaries.empty? %><p class="muted">No numeric metrics logged this week.</p><% end %><% @review.metric_summaries.each do |metric| %><div class="review-metric"><strong><%= metric[:label] %></strong><span><%= metric_number(metric[:average], metric[:unit]) %></span><small class="muted">Average of <%= pluralize(metric[:count], 'logged day') %></small></div><% end %></section>
  <section class="card feature-card"><h2>Shots taken</h2><% if @review.current.injections.empty? %><p class="muted">No actual injections logged this week.</p><% end %><% @review.current.injections.each do |shot| %><article class="review-entry"><strong><%= shot.dose.to_s('F') %> mg · <%= [shot.site, shot.side].compact_blank.join(' / ').presence || 'Location not recorded' %></strong><p class="small muted"><%= local_time_label(shot.recorded_at) %></p><%= link_to 'Open day →', journal_path(shot.local_day) %></article><% end %></section>
</div>
<section class="card feature-card"><h2>Notes & side effects</h2><% highlights = @review.current.notes.select { |note| note.notes.present? || note.metrics['side_effects'].present? } %><% if highlights.empty? %><p class="muted">No written notes or side effects logged this week.</p><% end %><% highlights.each do |note| %><article class="review-entry"><%= link_to note.local_date.strftime('%A, %b %-d'), journal_path(note.local_date) %><p class="pre-wrap"><%= note.notes %></p><% if note.metrics['side_effects'].present? %><p class="pre-wrap small">Side effects: <%= note.metrics['side_effects'] %><%= " · Severity #{note.metrics['severity']}/10" if note.metrics['severity'].present? %></p><% end %></article><% end %></section>
