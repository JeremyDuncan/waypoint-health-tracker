<section class="login card">
  <h1>Welcome home.</h1>
  <%= form_with url: session_path, class: "stack" do |f| %>
    <div><%= f.label :email_address, "Email" %><%= f.email_field :email_address, required: true, autocomplete: "username", autofocus: true %></div>
    <div><%= f.label :password %><%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></div>
    <%= f.submit "Sign in", class: "button primary" %>
  <% end %>
  <p class="small muted">Accounts and passwords are managed on your server.</p>
</section>
