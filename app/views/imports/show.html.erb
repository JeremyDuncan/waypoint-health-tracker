<%= link_to "← Back to settings", settings_path, class: "back-link" %><section class="page-intro"><div><h1>Review before saving.</h1><p class="muted">Existing entries are never overwritten.</p></div></section>
<% if @renpho %>
  <section class="card form-card">
    <h2>Renpho export detected</h2>
    <div class="renpho-details">
      <p><strong>Date + Time → actual reading time</strong><br>Weight(<%= @batch.payload["weight_unit"] %>) → entered weight in <%= @batch.payload["weight_unit"] %></p>
      <p class="small muted">Renpho files have no time zone, so check the one below.</p>
      <p class="small muted">Weigh-ins only; body composition, BMI and remarks are skipped.</p>
    </div>
    <%= form_with url: preview_import_path(@batch), class: "stack" do |f| %>
      <div><%= f.label :time_zone, "Time zone of these Renpho readings" %><%= f.select :time_zone, TZInfo::Timezone.all_identifiers, selected: @batch.payload["time_zone"] %></div>
      <%= f.submit "Update Renpho preview", class: "button secondary" %>
    <% end %>
  </section>
<% elsif @headers %>
  <% defaults = { "date_column" => "occurred_at", "value_column" => "value", "unit_column" => "unit", "id_column" => "id" } %>
  <section class="card form-card">
    <h2>Map your weight CSV</h2>
    <%= form_with url: preview_import_path(@batch), class: "mapping-grid" do |f| %>
      <% {date_column: "Date/time column", value_column: "Weight column", unit_column: "Unit column (optional)", id_column: "Stable ID column (optional)"}.each do |field, label| %>
        <div><%= f.label field, label %><%= f.select field, @headers, include_blank: "Choose column", selected: @mapping[field.to_s] || (defaults[field.to_s] if @headers.include?(defaults[field.to_s])) %></div>
      <% end %>
      <div><%= f.label :date_format, "Date format" %><%= f.select :date_format, [["ISO timestamp with offset", "iso"], ["YYYY-MM-DD (date only)", "ymd"], ["MM/DD/YYYY (date only)", "mdy"], ["DD/MM/YYYY (date only)", "dmy"]], selected: @mapping["date_format"] %></div>
      <div><%= f.label :unit, "Unit when no unit column" %><%= f.select :unit, [["Choose explicitly", ""], ["Pounds (lb)", "lb"], ["Kilograms (kg)", "kg"]], selected: @mapping["unit"] %></div>
      <div><%= f.label :offset, "UTC offset for date-only rows" %><%= f.text_field :offset, value: @mapping["offset"], placeholder: "-05:00" %></div>
      <p class="small muted">Date-only rows are saved at noon with this offset. Split files that span a clock change.</p>
      <%= f.submit "Validate & preview rows", class: "button primary" %>
    <% end %>
  </section>
<% end %>
<% if @report
  nothing_to_import = @report["creates"].zero? && @report["preferences"].blank?
  submit_label = if @batch.committed_at
    "Already committed"
  elsif @report["creates"] > 0
    "Import #{pluralize(@report['creates'], 'new entry', plural: 'new entries')}"
  elsif nothing_to_import
    "Nothing new to import"
  else
    "Finish without new entries"
  end %><section class="card form-card import-report"><h2>Import preview</h2><div class="import-counts"><span><strong><%= @report['creates'] %></strong> creates</span><span><strong><%= @report['duplicates'] %></strong> duplicates skipped</span><span><strong><%= @report['conflicts'] %></strong> conflicts</span><span><strong><%= @report['errors'].size %></strong> errors</span></div><% @report['errors'].each do |error| %><p class="errors">Row <%= error['row'] %>: <%= error['message'] %></p><% end %><% if @report['conflicts'] > 0 %><p class="errors">Conflicts block the import. Fix the file and upload again.</p><% end %><% if @report['duplicates'] > 0 %><p class="muted">Duplicates are skipped.</p><% end %><div class="table-scroll"><table><thead><tr><th>Row</th><th>Type</th><th>Result</th><th>Source values</th></tr></thead><tbody><% @report['rows'].each do |row| %><tr><td><%= row['row'] %></td><td><%= row['kind'] %></td><td><%= row['status'] == 'duplicates' ? 'duplicate (skipped)' : row['status'] %></td><td class="small"><%= row['data'].except('id').to_json %></td></tr><% end %></tbody></table></div><%= form_with url: commit_import_path(@batch), class: "stack" do |f| %><% if @report['preferences'] %><h3>Imported preferences</h3><pre><%= JSON.pretty_generate(@report['preferences']) %></pre><label class="check-label"><%= f.check_box :apply_preferences, checked: true %>Apply these preferences (including time zone, metrics and planned reminder)</label><% end %><%= f.submit submit_label, class: "button primary", disabled: @batch.committed_at.present? || nothing_to_import || @report['errors'].any? || @report['conflicts'] > 0, data: { turbo_submits_with: "Importing…" } %><% end %></section><% end %>
