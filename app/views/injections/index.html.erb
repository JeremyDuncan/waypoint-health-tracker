<div data-controller="injection-insights modal chart-preferences" data-modal-open-value="<%= @filter_error || params[:edit_filters] == '1' %>" data-chart-preferences-state-value="<%= @chart_preferences.to_json %>" data-chart-preferences-url-value="<%= chart_preferences_path(page: 'injections') %>" data-action="injection-insights:preferences->chart-preferences#save modal:closed->chart-preferences#restoreFilters" data-injection-insights-payload-value="<%= @insights.chart.to_json %>">
<section class="page-intro">
  <div><h1>Injections.</h1></div>
  <%= link_to "＋ Log injection", new_entry_path(kind: "injection"), class: "button primary" %>
</section>

<section class="compact-injection-summary" aria-label="Injection metrics for selected shots">
  <article class="card compact-injection-stat"><span class="compact-stat-label">Logged shots</span><strong class="compact-shot-count"><%= @insights.rows.length %></strong><span class="compact-change-dates muted"><%= @insights.range.from.strftime('%b %-d') %> – <%= @insights.range.to.strftime('%b %-d, %Y') %></span></article>
  <article class="card compact-injection-stat compact-change-stat" aria-label="Change across paired readings">
    <span class="compact-stat-label">Recorded change</span><div class="compact-change-value"><strong class="<%= change_class(@insights.overall_change) %>"><%= change_label(@insights.overall_change) %></strong><% unless @insights.overall_percent.nil? %><span><%= percent_loss_label(@insights.overall_percent) %></span><% end %></div>
    <span class="compact-change-dates muted"><% if @insights.first_reading %><%= @insights.first_reading.recorded_at.in_time_zone.strftime('%b %-d') %> → <%= @insights.last_reading.recorded_at.in_time_zone.strftime('%b %-d, %Y') %><% else %>No paired readings<% end %></span>
  </article>
</section>

<% if @insights.rows.empty? %>
  <section class="card feature-card"><h2>Weight &amp; injection dates</h2><%= render 'filters_toolbar' %><div class="insights-empty"><p class="muted">No injections match these filters.</p><%= link_to "Log injection", new_entry_path(kind: "injection"), class: "button primary" %></div></section>
<% else %>
<% if @insights.compared_rows.empty? %><aside class="insights-coverage-notice"><span>Comparisons need a weigh-in before and after a shot.</span><span><%= link_to "Log weight", new_entry_path(kind: "weight") %> · <%= link_to "Import weigh-ins", settings_path %></span></aside><% end %>
<div class="injection-visuals">
  <div class="insights-hero-grid">
    <section class="card location-panel" aria-labelledby="location-heading">
      <h2 id="location-heading">Locations</h2>
      <%= render "body_map", insights: @insights %>
      <div class="location-legend">
        <% @insights.locations.each do |name, stats| %>
          <div class="location-legend-item <%= site_class(name) %>"><span class="location-swatch" aria-hidden="true"></span><div><strong><%= name %></strong><span class="small muted"><%= pluralize(stats[:count], 'shot') %><% if stats[:count] > 0 %> · Left <%= stats[:sides]['Left'] %> / Right <%= stats[:sides]['Right'] %><% if stats[:sides]['Not recorded'] > 0 %> · <%= stats[:sides]['Not recorded'] %> without a side<% end %><% end %></span></div></div>
        <% end %>
      </div>
    </section>
    <section class="card insights-chart-panel injection-history-panel" aria-labelledby="trajectory-heading">
      <header class="injection-chart-heading"><h2 id="trajectory-heading" data-injection-insights-target="timelineTitle">Weight &amp; injection dates</h2></header>
      <%= render 'filters_toolbar' %>
      <p class="small muted" data-injection-insights-target="timelineExplanation"></p>
      <div class="insights-chart-wrap trajectory-wrap"><canvas data-injection-insights-target="trajectory" role="img" aria-label="Measured weight changes relative to each injection. Exact readings are listed in the shot cards below."></canvas><div class="injection-calendar-markers" data-injection-insights-target="calendarEvents"></div></div>
      <p class="small muted insights-chart-caption" data-injection-insights-target="trajectoryCaption"></p>
      <div data-injection-insights-target="doseLegend"><%= render 'shared/dose_key', doses: @insights.rows.map { |row| row[:injection].dose } %></div>
      <ul class="trajectory-key" data-injection-insights-target="trajectoryKey" aria-label="Compared shots" hidden></ul>
    </section>
  </div>

  <section class="card insights-chart-panel shot-chart-panel" aria-labelledby="shot-change-heading">
    <h2 id="shot-change-heading">Change per shot</h2>
    <p class="small muted">Faint bars are in progress. Tap a bar for details.</p>
    <div class="insights-chart-wrap" data-injection-insights-target="shotWrap"><canvas data-injection-insights-target="shots" role="img" aria-label="Observed weight change for each injection window. Missing pairs have no bar. Exact values are in the shot cards below."></canvas></div>
    <% if @insights.rows.length > 24 %><p class="small muted">Latest 24 shots.</p><% end %>
  </section>

  <div class="insights-comparison-grid">
    <section class="card insights-chart-panel" aria-labelledby="site-comparison-heading">
      <h2 id="site-comparison-heading">Change by location</h2>
      <div class="insights-chart-wrap comparison-wrap" data-injection-insights-target="siteWrap"><canvas data-injection-insights-target="sites" role="img" aria-label="Total measured weight change by location, with the average per shot. Shot counts are listed below."></canvas></div>
      <%= render "comparison", groups: @insights.site_groups, caption: "Location comparison details" %>
    </section>
    <section class="card insights-chart-panel" aria-labelledby="dose-comparison-heading">
      <h2 id="dose-comparison-heading">Change by dose</h2>
      <div class="insights-chart-wrap comparison-wrap" data-injection-insights-target="doseWrap"><canvas data-injection-insights-target="doses" role="img" aria-label="Total measured weight change while on each logged dose, with the average per shot. Shot counts are listed below."></canvas></div>
      <%= render "comparison", groups: @insights.dose_groups, caption: "Dose comparison details" %>
    </section>
  </div>
</div>
<% end %>

<details class="card insights-method" id="injection-method">
  <summary>How these numbers are calculated</summary>
  <div>
    <p><strong>Baseline:</strong> your last weigh-in up to three days before the shot.</p>
    <p><strong>Change:</strong> your last weigh-in after the shot, minus the baseline. A shot’s window ends at your next shot or after seven days. Filters never move a window, and no reading is estimated.</p>
    <p><strong>By location and dose:</strong> the total for every measured shot in the group, including ones in progress. Readings under 24 hours apart are left out. Small groups can shift a lot with one reading.</p>
    <p><strong>Recorded change:</strong> first baseline to latest follow-up among the selected shots, not a sum. The comparison chart shows the latest 12 measured shots.</p>
  </div>
</details>

<section class="shot-history" aria-labelledby="shot-history-heading">
  <div class="section-heading"><div><h2 id="shot-history-heading">Shot history</h2></div><span class="small muted"><%= pluralize(@insights.rows.length, 'shot') %></span></div>
  <% @insights.rows.reverse_each do |row| %><%= render "shot", row: row %><% end %>
</section>

<%= render 'shared/chart_filter_dialog', page: 'injections' %>
</div>
