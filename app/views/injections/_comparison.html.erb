<div class="comparison-details">
  <table>
    <caption class="sr-only"><%= caption %></caption>
    <thead><tr><th scope="col">Group</th><th scope="col">Total change</th><th scope="col">Shots</th></tr></thead>
    <tbody><% groups.each do |group| %><tr><th scope="row"><%= group[:label] %><span class="small muted comparison-span"><%= group[:average] ? "Average #{change_label(group[:average])} per shot" : "No measured shot yet" %></span></th><td class="<%= change_class(group[:change]) %>"><%= change_label(group[:change]) %><% if group[:percent] %><span class="comparison-span"><%= percent_loss_label(group[:percent]) %></span><% end %></td><td><%= group[:measured] %> of <%= pluralize(group[:shots], "shot") %> measured<% if group[:in_progress].positive? %><span class="small muted comparison-span"><%= group[:in_progress] %> in progress</span><% end %></td></tr><% end %></tbody>
  </table>
</div>
