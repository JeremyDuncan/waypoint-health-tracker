<section class="card form-card">
  <h2>Change password</h2>
  <p class="muted">12–72 characters, up to 72 bytes (accents and emoji use more than one). This signs you out on every device.</p>
  <%= errors_for(current_user) if @password_change %>
  <%= form_with scope: :user, url: settings_password_path, method: :patch, class: "stack" do |f| %>
    <div>
      <%= f.label :current_password, "Current password" %>
      <%= f.password_field :current_password, required: true, autocomplete: "current-password" %>
    </div>
    <div>
      <%= f.label :password, "New password" %>
      <%= f.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm new password" %>
      <%= f.password_field :password_confirmation, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %>
    </div>
    <%= f.submit "Change password", class: "button primary" %>
  <% end %>
</section>
