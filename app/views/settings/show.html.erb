<section class="page-intro"><div><h1>Your settings.</h1></div></section>
<div class="feature-toolbar"><%= link_to 'Goals & milestones →', goal_path, class: 'button secondary' %><%= link_to 'Appointment report →', report_path, class: 'button secondary' %></div>
<div class="settings-grid"><section class="card form-card"><h2>Daily preferences</h2><%= errors_for(current_user) unless @password_change %>
<%= form_with scope: :user, url: settings_path, method: :patch, class: "stack" do |f| %><div><%= f.label :preferred_unit, "Preferred weight unit" %><%= f.select :preferred_unit, [["Pounds (lb)","lb"],["Kilograms (kg)","kg"]], selected: current_user.preferred_unit %></div><div><%= f.label :time_zone, "Time zone" %><%= f.select :time_zone, TZInfo::Timezone.all_identifiers, selected: current_user.time_zone %></div><fieldset><legend>Optional journal metrics</legend><%= hidden_field_tag "user[enabled_metrics][]", "", disabled: true %><% MetricDefinitions::ALL.each do |key, definition| %><label class="check-label"><%= check_box_tag "user[enabled_metrics][]", key, current_user.enabled_metrics.include?(key) %><%= definition['label'] %> <span class="muted small"><%= definition['unit'] %></span></label><% end %></fieldset><div><%= f.label :reminder_local, "Planned injection reminder (optional)" %><%= f.datetime_local_field :reminder_local, value: current_user.reminder_at&.in_time_zone&.strftime('%Y-%m-%dT%H:%M') %><p class="field-hint">Shown on your dashboard only. Clear to remove.</p></div><%= f.submit "Save preferences", class: "button primary" %><% end %></section>
<div class="stack"><%= render "password_form" %><section class="card form-card"><h2>Export</h2><p class="muted">Your entries, notes and preferences. No passwords or account data.</p><div class="export-links"><%= link_to "↓ Full JSON · v1", export_path("json"), class: "button primary", data: { turbo: false } %><% {"weights"=>"Weight CSV","injections"=>"Injection CSV","day_notes"=>"Journal CSV"}.each do |kind,label| %><%= link_to "↓ #{label}", export_path(kind), class: "button secondary", data: { turbo: false } %><% end %></div><div class="divider"></div><h3>Import</h3><p class="small muted">You’ll review everything before it’s saved. Previews expire after an hour.</p><%= form_with url: imports_path, multipart: true, class: "stack" do |f| %><div><%= f.label :format_kind, "File type" %><%= f.select :format_kind, [["Waypoint Health personal JSON v1","json"],["Weight CSV (map columns)","csv"],["Renpho Health CSV","renpho"]] %></div><div><%= f.label :file, "UTF-8 file · up to 5 MB" %><%= f.file_field :file, accept: ".json,.csv,application/json,text/csv", required: true %></div><%= f.submit "Upload & preview", class: "button secondary" %><% end %><p class="small"><a href="/examples/renpho-weights.csv" download>Example Renpho CSV</a> · <a href="/examples/scale-weights.csv" download>Example scale CSV</a> · <a href="/examples/weights.csv" download>Example weight export</a> · <a href="/data-format.html">Data format reference</a></p></section>
<section class="card form-card"><h2>Server backup</h2><%= render "backup_status" %><p class="muted">Includes all accounts and records. Run on your host:</p><pre><code>docker compose --env-file .env.production exec app bin/backup /data/backup-YYYYMMDD.sqlite3</code></pre><p class="small muted">Use a new filename each time, and copy it and <code>.env.production</code> off the server. Restore steps are in the README.</p><p class="small muted">iPhone app: in Safari, tap Share, then Add to Home Screen.</p></section>
<%= render "clear_history" %></div></div>
