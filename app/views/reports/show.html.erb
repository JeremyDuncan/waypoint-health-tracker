<section class="page-intro"><div><div class="eyebrow">BRING THE BIGGER PICTURE</div><h1>Appointment report.</h1><p class="muted">Choose what to share, preview it, and download a PDF generated on your server.</p></div><%= link_to '↓ Download PDF', report_path(format: :pdf, range: 'custom', from: @report.range.from, to: @report.range.to, include_notes: @report.include_notes ? '1' : '0', include_metrics: @report.include_metrics ? '1' : '0'), class: 'button primary', data: { turbo: false } %></section>
<section class="card feature-card report-options"><%= form_with url: report_path, method: :get, class: 'feature-toolbar' do |f| %><%= f.hidden_field :range, value: 'custom' %><div><%= f.label :from, 'From' %><%= f.date_field :from, value: @report.range.from, required: true %></div><div><%= f.label :to, 'Through' %><%= f.date_field :to, value: @report.range.to, required: true %></div><label class="check-label"><%= f.check_box :include_metrics, checked: @report.include_metrics %>Include journal metrics and recorded side effects</label><label class="check-label"><%= f.check_box :include_notes, checked: @report.include_notes %>Include written journal and injection notes</label><%= f.submit 'Update preview', class: 'button secondary' %><% end %><p class="small muted">Up to one year. The PDF uses the choices in this preview. Login details and planned reminders are excluded.</p></section>
<section class="card feature-card report-preview"><div class="section-heading"><h2>Your appointment summary</h2><span class="small muted"><%= @report.range.from %> → <%= @report.range.to %> · <%= current_user.time_zone %></span></div><div class="report-summary"><p><strong><%= @report.range.weights.size %></strong> weigh-ins</p><p><strong><%= @report.range.injections.size %></strong> actual injections</p><p>Weight change <strong><%= metric_number(@report.weight_change) %></strong> · <%= percent_loss_label(@report.weight_change_percent) %></p></div><%= render 'shared/weight_plot', plot: @report.plot, range: @report.range %><h3>Actual injections</h3><% if @report.range.injections.empty? %><p class="muted">No actual injections in this range.</p><% end %><% @report.range.injections.each do |shot| %><article class="review-entry"><strong><%= local_time_label(shot.recorded_at) %> · <%= shot.dose.to_s('F') %> mg</strong><p><%= [shot.site, shot.side].compact_blank.join(' / ').presence || 'Location not recorded' %></p><% if @report.include_notes %><p class="pre-wrap"><%= shot.notes %></p><% end %></article><% end %>
<% if @report.include_metrics %><h3>Journal metrics</h3><% if @report.metrics.empty? %><p class="muted">No journal metrics in this range.</p><% end %><% @report.metrics.each do |note| %><article class="review-entry"><strong><%= note.local_date %></strong><% note.metrics.each do |key, value| %><p class="small pre-wrap"><%= MetricDefinitions::ALL.fetch(key)['label'] %>: <%= MetricDefinitions.format_value(key, value) %></p><% end %></article><% end %><% end %>
<% if @report.include_notes %><h3>Journal notes</h3><% @report.range.notes.select { |note| note.notes.present? }.each do |note| %><article class="review-entry"><strong><%= note.local_date %></strong><p class="pre-wrap"><%= note.notes %></p></article><% end %><% end %>
<details><summary>Exact weigh-ins · original values and units</summary><% @report.range.weights.each do |weight| %><p class="small"><%= local_time_label(weight.recorded_at) %> · <%= weight_label(weight) %> (<%= metric_number(weight.in_unit(current_user.preferred_unit)) %>)</p><% end %></details></section>
