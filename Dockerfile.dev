FROM ruby:3.4.8-slim

WORKDIR /app
RUN apt-get update -qq && apt-get install --no-install-recommends -y \
    build-essential libyaml-dev pkg-config curl sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home app \
    && mkdir -p /data /app/tmp /app/log \
    && chown -R app:app /data /app

# Ignore host-specific .bundle/config when the checkout is mounted into /app.
ENV RAILS_ENV=development BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_IGNORE_CONFIG=1 BUNDLE_FROZEN=true BUNDLE_WITHOUT="" \
    DATABASE_PATH=/data/development.sqlite3
COPY Gemfile Gemfile.lock ./
RUN bundle install
COPY --chown=app:app . .

USER app
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=3 CMD curl -fsS http://127.0.0.1:3000/up || exit 1
ENTRYPOINT ["/app/bin/docker-entrypoint"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
