#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_dir"
env_file=${DEV_ENV_FILE:-$repo_dir/.env}
project=${DEV_COMPOSE_PROJECT:-health-tracker-dev}

if [ ! -f "$env_file" ]; then
  printf '%s\n' "Development configuration is missing: $env_file" \
    'Start development first with ./script/dev/run.' >&2
  exit 1
fi

# Keep the terminal for hidden password prompts; support piped input as well.
if [ -t 0 ] && [ -t 1 ]; then
  set --
else
  set -- -T
fi
exec docker compose --env-file "$env_file" -f "$repo_dir/compose.dev.yaml" \
  --project-name "$project" exec "$@" app bin/account create
