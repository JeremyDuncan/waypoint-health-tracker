# Production template: copy to .env.production, or use bin/init-env.
# Development .env is generated by ./script/dev/run.
# Generate once with: openssl rand -hex 64
SECRET_KEY_BASE=replace_with_generated_secret
# Comma-separated hostnames, without scheme or port.
APP_HOST=health.example.home,localhost
FORCE_SSL=true
# Bind to loopback for an existing reverse proxy on the Docker host.
BIND_ADDRESS=127.0.0.1
PORT=3000
